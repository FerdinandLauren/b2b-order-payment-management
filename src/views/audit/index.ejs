<%- include('../partials/head') %>

<div class="page-head">
  <div>
    <div class="eyebrow">Governance · Audit</div>
    <h1 class="page-title">Audit trail</h1>
    <p class="page-sub">Immutable record of business actions, approvals, inventory movements, invoices, and payments.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-secondary" href="/dashboard">
      <svg class="icon"><use href="#i-dashboard"></use></svg>
      Dashboard
    </a>
  </div>
</div>

<form class="filter-bar" method="get" action="/audit">
  <div class="field">
    <label for="entityType">Entity</label>
    <select class="select input-sm" id="entityType" name="entityType">
      <option value="">All entities</option>
      <% entityTypes.forEach(function (type) { %>
        <option value="<%= type %>" <%= filters.entityType === type ? 'selected' : '' %>><%= entityLabels[type] || type %></option>
      <% }); %>
    </select>
  </div>
  <div class="field">
    <label for="action">Action</label>
    <select class="select input-sm" id="action" name="action">
      <option value="">All actions</option>
      <% actions.forEach(function (action) { %>
        <option value="<%= action %>" <%= filters.action === action ? 'selected' : '' %>><%= actionLabels[action] %></option>
      <% }); %>
    </select>
  </div>
  <div class="field">
    <label for="dateFrom">From</label>
    <input class="input input-sm" id="dateFrom" name="dateFrom" type="date" value="<%= filters.dateFrom %>">
  </div>
  <div class="field">
    <label for="dateTo">To</label>
    <input class="input input-sm" id="dateTo" name="dateTo" type="date" value="<%= filters.dateTo %>">
  </div>
  <button class="btn btn-secondary btn-sm" type="submit">
    <svg class="icon"><use href="#i-search"></use></svg>
    Filter
  </button>
  <a class="btn btn-ghost btn-sm" href="<%= resetHref %>">Reset</a>
  <div class="filter-spacer"></div>
  <span class="text-xs text-muted"><%= helpers.number(total) %> record<%= total === 1 ? '' : 's' %></span>
</form>

<% if (!entries.length) { %>
  <div class="table-wrap">
    <div class="empty">
      <div class="empty-icon"><svg class="icon"><use href="#i-audit"></use></svg></div>
      <div class="empty-title">No audit records match</div>
      <div class="empty-text">Adjust the filters or perform a business action to generate an audit record.</div>
      <a class="btn btn-secondary" href="/audit">Clear filters</a>
    </div>
  </div>
<% } else { %>
  <div class="table-wrap">
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>Timestamp</th>
            <th>Action</th>
            <th>Entity</th>
            <th>Summary</th>
            <th>User</th>
            <th>IP address</th>
          </tr>
        </thead>
        <tbody>
          <% entries.forEach(function (entry) { %>
            <tr>
              <td class="text-sm text-muted nowrap"><%= helpers.datetime(entry.createdAt) %></td>
              <td>
                <span class="badge badge-<%= entry.tone %>"><%= entry.label %></span>
              </td>
              <td>
                <% if (entry.href) { %>
                  <a class="link" href="<%= entry.href %>"><%= entry.entityLabel %></a>
                <% } else { %>
                  <span class="text-sm"><%= entry.entityLabel %></span>
                <% } %>
                <% if (entry.entityId) { %>
                  <div class="cell-sub cell-mono">#<%= entry.entityId %></div>
                <% } %>
              </td>
              <td class="text-sm"><%= entry.summary %></td>
              <td class="text-sm"><%= entry.userName %></td>
              <td class="text-sm text-muted cell-mono"><%= entry.ipAddress || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="table-foot">
      <span>
        <% if (pages > 1) { %>
          Page <%= page %> of <%= pages %> · <%= helpers.number(total) %> records
        <% } else { %>
          <%= helpers.number(total) %> record<%= total === 1 ? '' : 's' %>
        <% } %>
      </span>
      <% if (pages > 1) { %>
        <div class="table-actions">
          <% if (previousHref) { %>
            <a class="btn btn-secondary btn-sm" href="<%= previousHref %>">Previous</a>
          <% } %>
          <% pageLinks.forEach(function (link) { %>
            <a class="btn <%= link.active ? 'btn-primary' : 'btn-secondary' %> btn-sm" href="<%= link.href %>"><%= link.number %></a>
          <% }); %>
          <% if (nextHref) { %>
            <a class="btn btn-secondary btn-sm" href="<%= nextHref %>">Next</a>
          <% } %>
        </div>
      <% } else { %>
        <span>Recorded automatically by the application</span>
      <% } %>
    </div>
  </div>
<% } %>

<%- include('../partials/foot') %>
