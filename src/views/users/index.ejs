<%- include('../partials/head') %>

<div class="page-head">
  <div>
    <div class="eyebrow">Administration</div>
    <h1 class="page-title">Users &amp; roles</h1>
    <p class="page-sub">Manage system accounts and role assignments. Administrative access does not grant business approvals.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-primary" href="/users/new">
      <svg class="icon"><use href="#i-plus"></use></svg>
      Add user
    </a>
  </div>
</div>

<% if (!users.length) { %>
  <div class="table-wrap">
    <div class="empty">
      <div class="empty-icon"><svg class="icon"><use href="#i-users"></use></svg></div>
      <div class="empty-title">No users yet</div>
      <div class="empty-text">Create the first account to give a team member access to the system.</div>
      <a class="btn btn-primary" href="/users/new">Add user</a>
    </div>
  </div>
<% } else { %>
  <div class="table-wrap">
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>User</th>
            <th>Username</th>
            <th>Role</th>
            <th>Status</th>
            <th>Created</th>
            <th class="right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function (user) { %>
            <tr>
              <td>
                <div class="user-cell">
                  <div class="avatar"><%= initials(user.full_name) %></div>
                  <div>
                    <div class="cell-primary"><%= user.full_name %></div>
                    <div class="cell-sub"><%= user.id === currentUser.id ? 'Currently signed in' : 'System user' %></div>
                  </div>
                </div>
              </td>
              <td><span class="cell-mono"><%= user.username %></span></td>
              <td><span class="badge badge-neutral"><%= enums.ROLES[user.role] %></span></td>
              <td><span class="badge badge-<%= badge(user.status) %>"><%= user.status === 'active' ? 'Active' : 'Inactive' %></span></td>
              <td class="text-sm text-muted"><%= helpers.date(user.created_at) %></td>
              <td>
                <div class="table-actions">
                  <a class="btn btn-ghost btn-sm" href="/users/<%= user.id %>/edit">Edit</a>
                  <% if (user.id !== currentUser.id) { %>
                    <form method="post" action="/users/<%= user.id %>/status"
                          data-confirm="<%= user.status === 'active' ? 'Deactivate this user?' : 'Activate this user?' %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="status" value="<%= user.status === 'active' ? 'inactive' : 'active' %>">
                      <button class="btn btn-ghost btn-sm <%= user.status === 'active' ? 'text-danger' : 'text-success' %>" type="submit">
                        <%= user.status === 'active' ? 'Deactivate' : 'Activate' %>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="table-foot">
      <span><%= users.length %> account<%= users.length === 1 ? '' : 's' %></span>
      <span>Role permissions follow the PRD 6-role model</span>
    </div>
  </div>
<% } %>

<%- include('../partials/foot') %>
