<%- include('../partials/head') %>

<div class="page-head">
  <div>
    <div class="eyebrow">Finance · Receipts</div>
    <h1 class="page-title">Payments</h1>
    <p class="page-sub">Record customer payments and allocate them to open invoices. Unallocated amounts stay on the payment until applied.</p>
  </div>
  <% if (isFinance) { %>
    <div class="page-actions">
      <a class="btn btn-primary" href="/payments/new">
        <svg class="icon"><use href="#i-plus"></use></svg>
        Record payment
      </a>
    </div>
  <% } %>
</div>

<div class="stat-grid">
  <div class="stat">
    <div class="stat-label">Total received</div>
    <div class="stat-value stat-value-sm"><%= helpers.rupiah(stats.totalReceived) %></div>
    <div class="stat-meta">All recorded customer payments</div>
  </div>
  <div class="stat <%= stats.unallocated > 0.005 ? 'stat-warning' : 'stat-success' %>">
    <div class="stat-label">Unallocated</div>
    <div class="stat-value stat-value-sm"><%= helpers.rupiah(stats.unallocated) %></div>
    <div class="stat-meta">Available to apply to invoices</div>
  </div>
  <div class="stat">
    <div class="stat-label">Fully allocated</div>
    <div class="stat-value"><%= stats.fullyAllocatedCount %></div>
    <div class="stat-meta"><%= stats.partiallyAllocatedCount %> partially allocated</div>
  </div>
  <div class="stat">
    <div class="stat-label">Payments</div>
    <div class="stat-value"><%= stats.total %></div>
    <div class="stat-meta">Payment history records</div>
  </div>
</div>

<form class="filter-bar" method="get" action="/payments">
  <div class="field">
    <label for="q">Search</label>
    <input class="input input-sm" id="q" name="q" type="text" value="<%= filters.q %>" placeholder="Payment, reference, or customer">
  </div>
  <div class="field">
    <label for="status">Status</label>
    <select class="select input-sm" id="status" name="status">
      <option value="">All statuses</option>
      <% statuses.forEach(function (status) { %>
        <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= enums.PAYMENT_STATUS[status] %></option>
      <% }); %>
    </select>
  </div>
  <button class="btn btn-secondary btn-sm" type="submit">
    <svg class="icon"><use href="#i-search"></use></svg>
    Filter
  </button>
  <a class="btn btn-ghost btn-sm" href="/payments">Reset</a>
  <div class="filter-spacer"></div>
  <span class="text-xs text-muted"><%= payments.length %> payment<%= payments.length === 1 ? '' : 's' %></span>
</form>

<% if (!payments.length) { %>
  <div class="table-wrap">
    <div class="empty">
      <div class="empty-icon"><svg class="icon"><use href="#i-payments"></use></svg></div>
      <div class="empty-title">No payments recorded</div>
      <div class="empty-text">Customer receipts and their invoice allocations will appear here.</div>
      <% if (isFinance) { %>
        <a class="btn btn-primary" href="/payments/new">Record a payment</a>
      <% } %>
    </div>
  </div>
<% } else { %>
  <div class="table-wrap">
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>Payment</th>
            <th>Customer</th>
            <th>Payment date</th>
            <th>Method</th>
            <th>Reference</th>
            <th class="right">Amount</th>
            <th class="right">Unallocated</th>
            <th>Status</th>
            <th class="right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% payments.forEach(function (payment) { %>
            <tr>
              <td><a class="link" href="/payments/<%= payment.id %>"><%= payment.payment_number %></a></td>
              <td>
                <div class="cell-primary"><%= payment.customer_name %></div>
                <div class="cell-sub cell-mono"><%= payment.customer_code %></div>
              </td>
              <td class="text-sm text-muted"><%= helpers.date(payment.payment_date) %></td>
              <td class="text-sm"><%= enums.PAYMENT_METHOD[payment.method] || payment.method %></td>
              <td class="text-sm text-muted"><%= payment.reference || '—' %></td>
              <td class="right money"><%= helpers.rupiah(payment.amount) %></td>
              <td class="right money fw-600"><%= helpers.rupiah(payment.unallocated) %></td>
              <td><span class="badge badge-<%= badge(payment.status) %>"><%= enums.PAYMENT_STATUS[payment.status] %></span></td>
              <td>
                <div class="table-actions">
                  <a class="btn btn-secondary btn-sm" href="/payments/<%= payment.id %>">View</a>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="table-foot">
      <span><%= payments.length %> payment<%= payments.length === 1 ? '' : 's' %></span>
      <span>Allocations update invoice balances immediately</span>
    </div>
  </div>
<% } %>

<%- include('../partials/foot') %>
