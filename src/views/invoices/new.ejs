<%- include('../partials/head') %>

<div class="page-head">
  <div>
    <div class="eyebrow">Finance · New invoice</div>
    <h1 class="page-title"><%= delivery ? 'Generate invoice' : 'Select a delivered shipment' %></h1>
    <p class="page-sub">
      <% if (delivery) { %>
        Invoice for <strong><%= delivery.delivery_number %></strong> · <%= delivery.customer_name %>.
        Billable quantities match the confirmed delivery and cannot be edited.
      <% } else { %>
        Choose a delivered shipment that still has uninvoiced quantities.
      <% } %>
    </p>
  </div>
  <div class="page-actions">
    <a class="btn btn-secondary" href="/invoices">
      <svg class="icon"><use href="#i-arrow-left"></use></svg>
      Invoices
    </a>
  </div>
</div>

<% if (!delivery) { %>
  <% if (!deliveries.length) { %>
    <div class="table-wrap">
      <div class="empty">
        <div class="empty-icon"><svg class="icon"><use href="#i-invoices"></use></svg></div>
        <div class="empty-title">Nothing to invoice</div>
        <div class="empty-text">Delivered shipments with uninvoiced quantities will appear here.</div>
        <a class="btn btn-secondary" href="/deliveries">View deliveries</a>
      </div>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th>Delivery</th>
              <th>Customer</th>
              <th>Sales order</th>
              <th>Delivery date</th>
              <th class="right">Billable quantity</th>
              <th class="right">Billable value</th>
              <th class="right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% deliveries.forEach(function (item) { %>
              <tr>
                <td><a class="link" href="/deliveries/<%= item.id %>"><%= item.delivery_number %></a></td>
                <td>
                  <div class="cell-primary"><%= item.customer_name %></div>
                  <div class="cell-sub cell-mono"><%= item.customer_code %></div>
                </td>
                <td><a class="link" href="/orders/<%= item.order_id %>"><%= item.order_number %></a></td>
                <td class="text-sm text-muted"><%= helpers.date(item.delivery_date) %></td>
                <td class="right money"><%= helpers.number(item.billable_quantity, 2) %></td>
                <td class="right money"><%= helpers.rupiah(item.billable_value) %></td>
                <td>
                  <div class="table-actions">
                    <a class="btn btn-primary btn-sm" href="/invoices/new?deliveryId=<%= item.id %>">Generate</a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="table-foot">
        <span><%= deliveries.length %> shipment<%= deliveries.length === 1 ? '' : 's' %> ready to invoice</span>
        <span>One delivery generates at most one active invoice</span>
      </div>
    </div>
  <% } %>
<% } else { %>
  <form method="post" action="/invoices">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="deliveryId" value="<%= delivery.id %>">

    <div class="detail-grid">
      <div>
        <div class="card">
          <div class="card-head">
            <div>
              <div class="card-title">Invoice lines</div>
              <div class="card-sub">Quantities are copied from the confirmed delivery lines.</div>
            </div>
          </div>
          <div class="table-scroll">
            <table class="table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th class="right">Delivered</th>
                  <th class="right">Already invoiced</th>
                  <th class="right">Billable</th>
                  <th class="right">Unit price</th>
                  <th class="right">Line total</th>
                </tr>
              </thead>
              <tbody>
                <% lines.forEach(function (line) { %>
                  <tr>
                    <td>
                      <div class="cell-primary"><%= line.product_name %></div>
                      <div class="cell-sub cell-mono"><%= line.sku %> · <%= line.unit %></div>
                    </td>
                    <td class="right money"><%= helpers.number(line.quantity, 2) %></td>
                    <td class="right money"><%= helpers.number(line.invoiced_quantity, 2) %></td>
                    <td class="right money fw-600"><%= helpers.number(line.billable_quantity, 2) %></td>
                    <td class="right money"><%= helpers.rupiah(line.unit_price) %></td>
                    <td class="right money"><%= helpers.rupiah(line.billable_quantity * line.unit_price) %></td>
                  </tr>
                <% }); %>
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="4" class="right fw-600">Subtotal</td>
                  <td></td>
                  <td class="right money fw-600"><%= helpers.rupiah(subtotal) %></td>
                </tr>
                <tr>
                  <td colspan="4" class="right fw-600">Total</td>
                  <td></td>
                  <td class="right money fw-600"><%= helpers.rupiah(subtotal) %></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>

      <div>
        <div class="card">
          <div class="card-head">
            <div>
              <div class="card-title">Invoice details</div>
            </div>
          </div>
          <div class="card-body">
            <div class="field">
              <label for="invoiceDate">Invoice date <span class="req">*</span></label>
              <input class="input" id="invoiceDate" name="invoiceDate" type="date" value="<%= invoiceDate %>" required>
            </div>
            <div class="meta-list">
              <div class="meta-row"><span class="meta-label">Delivery</span><span class="meta-value"><%= delivery.delivery_number %></span></div>
              <div class="meta-row"><span class="meta-label">Sales order</span><span class="meta-value"><%= delivery.order_number %></span></div>
              <div class="meta-row"><span class="meta-label">Customer</span><span class="meta-value"><%= delivery.customer_name %></span></div>
              <div class="meta-row"><span class="meta-label">Payment terms</span><span class="meta-value"><%= delivery.payment_terms_days %> days</span></div>
              <div class="meta-row"><span class="meta-label">Due date if issued today</span><span class="meta-value"><%= helpers.date(dueDate) %></span></div>
            </div>
            <div class="alert alert-info mt-2" role="status">
              <svg class="icon"><use href="#i-alert"></use></svg>
              <div class="alert-body"><p>The invoice is created as a draft. Issue it when it is ready to send to the customer. Tax is outside the MVP scope.</p></div>
            </div>
          </div>
          <div class="card-body">
            <div class="form-actions">
              <a class="btn btn-secondary" href="/invoices/new">Cancel</a>
              <button class="btn btn-primary" type="submit">Generate invoice</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>
<% } %>

<%- include('../partials/foot') %>
