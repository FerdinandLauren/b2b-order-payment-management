<%- include('../partials/head') %>

<div class="page-head">
  <div>
    <div class="eyebrow">Fulfillment · New delivery</div>
    <h1 class="page-title"><%= order ? 'Prepare delivery' : 'Select a sales order' %></h1>
    <p class="page-sub">
      <% if (order) { %>
        Delivery for <strong><%= order.order_number %></strong> · <%= order.customer_name %>.
        Quantities are limited to the remaining undelivered balance.
      <% } else { %>
        Choose an approved sales order that still has quantities to deliver.
      <% } %>
    </p>
  </div>
  <div class="page-actions">
    <a class="btn btn-secondary" href="/deliveries">
      <svg class="icon"><use href="#i-arrow-left"></use></svg>
      Deliveries
    </a>
  </div>
</div>

<% if (!order) { %>
  <% if (!board.orders.length) { %>
    <div class="table-wrap">
      <div class="empty">
        <div class="empty-icon"><svg class="icon"><use href="#i-deliveries"></use></svg></div>
        <div class="empty-title">No orders are ready for fulfillment</div>
        <div class="empty-text">Approved orders with an undelivered balance will appear here.</div>
        <a class="btn btn-secondary" href="/orders">View sales orders</a>
      </div>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th>Order</th>
              <th>Customer</th>
              <th>Order date</th>
              <th class="right">Ordered</th>
              <th class="right">Committed</th>
              <th class="right">Remaining</th>
              <th class="right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% board.orders.forEach(function (item) { %>
              <tr>
                <td><a class="link" href="/orders/<%= item.id %>"><%= item.order_number %></a></td>
                <td>
                  <div class="cell-primary"><%= item.customer_name %></div>
                  <div class="cell-sub cell-mono"><%= item.customer_code %></div>
                </td>
                <td class="text-sm text-muted"><%= helpers.date(item.order_date) %></td>
                <td class="right money"><%= helpers.number(item.order_quantity, 2) %></td>
                <td class="right money"><%= helpers.number(item.committed_quantity, 2) %></td>
                <td class="right money"><%= helpers.number(item.order_quantity - item.committed_quantity, 2) %></td>
                <td>
                  <div class="table-actions">
                    <a class="btn btn-primary btn-sm" href="/deliveries/new?orderId=<%= item.id %>">Prepare</a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
<% } else { %>
  <form method="post" action="/deliveries">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="orderId" value="<%= order.id %>">

    <div class="detail-grid">
      <div>
        <div class="card">
          <div class="card-head">
            <div>
              <div class="card-title">Delivery lines</div>
              <div class="card-sub">Enter the quantity being delivered now. Leave a line at zero to skip it.</div>
            </div>
          </div>
          <div class="table-scroll">
            <table class="table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th class="right">Ordered</th>
                  <th class="right">Cancelled</th>
                  <th class="right">Committed</th>
                  <th class="right">Remaining</th>
                  <th class="right" style="width: 140px">Deliver now</th>
                </tr>
              </thead>
              <tbody>
                <% lines.forEach(function (line) { %>
                  <tr>
                    <td>
                      <div class="cell-primary"><%= line.product_name %></div>
                      <div class="cell-sub cell-mono"><%= line.sku %> · <%= line.unit %></div>
                    </td>
                    <td class="right money"><%= helpers.number(line.quantity, 2) %></td>
                    <td class="right money"><%= helpers.number(line.cancelled_quantity, 2) %></td>
                    <td class="right money"><%= helpers.number(line.committed_quantity, 2) %></td>
                    <td class="right money"><%= helpers.number(line.remaining_quantity, 2) %></td>
                    <td class="right">
                      <input class="input input-sm text-right" type="number" step="0.001" min="0"
                             max="<%= line.remaining_quantity %>"
                             name="quantity_<%= line.id %>"
                             value="<%= line.remaining_quantity %>"
                             <%= line.remaining_quantity <= 0 ? 'disabled' : '' %>>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div>
        <div class="card">
          <div class="card-head">
            <div>
              <div class="card-title">Delivery details</div>
            </div>
          </div>
          <div class="card-body">
            <div class="field">
              <label for="deliveryDate">Delivery date</label>
              <input class="input" id="deliveryDate" name="deliveryDate" type="date" value="<%= deliveryDate %>" required>
            </div>
            <div class="field">
              <label for="notes">Notes</label>
              <textarea class="textarea" id="notes" name="notes" maxlength="500" placeholder="Optional instructions or reference"></textarea>
            </div>
            <div class="meta-list">
              <div class="meta-row"><span class="meta-label">Sales order</span><span class="meta-value"><%= order.order_number %></span></div>
              <div class="meta-row"><span class="meta-label">Customer</span><span class="meta-value"><%= order.customer_name %></span></div>
              <div class="meta-row"><span class="meta-label">Order status</span><span class="meta-value"><span class="badge badge-<%= badge(order.status) %>"><%= enums.ORDER_STATUS[order.status] %></span></span></div>
            </div>
            <div class="alert alert-info mt-2" role="status">
              <svg class="icon"><use href="#i-alert"></use></svg>
              <div class="alert-body"><p>The delivery is created as a draft. Stock is issued only when it is dispatched.</p></div>
            </div>
          </div>
          <div class="card-body">
            <div class="form-actions">
              <a class="btn btn-secondary" href="/deliveries">Cancel</a>
              <button class="btn btn-primary" type="submit">Create delivery</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>
<% } %>

<%- include('../partials/foot') %>
